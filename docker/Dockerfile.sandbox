FROM python:3.11-slim

# Install system-level dependencies required for parsing tools
# Adding libgl1-mesa-glx ensures PDF/image processing libraries don't fail on missing C-bindings
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Install the heavy-lifter Python libraries for data and document parsing
# Pinning versions is critical so V's scripts don't break on unexpected package updates
RUN pip install --no-cache-dir \
    "numpy<2.0" \
    pdfplumber==0.10.3 \
    pandas==2.1.1 \
    openpyxl==3.1.2

# Create non-root user for execution and setup workspace
RUN useradd -m -s /bin/bash v_sandbox
WORKDIR /workspace

# Explicitly grant the sandbox user ownership of the workspace
# Without this, V's generated scripts might hit PermissionErrors when trying to write temporary output files
RUN chown -R v_sandbox:v_sandbox /workspace

USER v_sandbox
CMD ["/bin/bash"]